<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="[8.23.0]" />
    <PackageVersion Include="Microsoft.Kiota.Bundle" Version="[2.1.2]" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackageUnderTest)' != ''">
    <PackageVersion Include="OneNexus.Sdk.Cas" Version="[$(PackageUnderTest)]" />
    <PackageVersion Include="OneNexus.Sdk.Cas.Support" Version="[$(PackageUnderTest)]" />
    <PackageVersion Include="OneNexus.Sdk.Core" Version="[$(PackageUnderTest)]" />
  </ItemGroup>
</Project>
