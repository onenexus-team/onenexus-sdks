<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Generated validators and embedded canonical OneNexus log contract.</Description>
    <ContractRoot>../../../contracts/log-correlation</ContractRoot>
    <CorvusJsonSchemaDefaultAccessibility>Internal</CorvusJsonSchemaDefaultAccessibility>
    <CorvusJsonSchemaAddExplicitUsings>true</CorvusJsonSchemaAddExplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Corvus.Json.ExtendedTypes" Version="[5.7.5]" />
    <PackageReference Include="Corvus.Json.SourceGenerator" Version="[5.7.5]" PrivateAssets="all" />
    <AdditionalFiles Include="$(ContractRoot)/schema.json" />
    <EmbeddedResource Include="$(ContractRoot)/*.json" LogicalName="Contract.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
