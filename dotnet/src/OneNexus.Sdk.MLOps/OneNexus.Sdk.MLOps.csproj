<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version Condition="'$(Version)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../../VERSION').Trim())</Version>
    <Authors>OneNexus</Authors>
    <RepositoryUrl>https://github.com/onenexus-team/onenexus-sdks</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Typed .NET client for the OneNexus MLOps service.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OneNexus.Sdk.Core/OneNexus.Sdk.Core.csproj" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- The client uses Core internals and must run with the Core version it was compiled against. -->
  <Target Name="PinSdkCoreDependency" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" Condition="'%(Filename)' == 'OneNexus.Sdk.Core'"
                                      ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>
</Project>
