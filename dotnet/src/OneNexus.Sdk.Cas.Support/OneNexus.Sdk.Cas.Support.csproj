<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version Condition="'$(Version)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../../VERSION').Trim())</Version>
    <Authors>OneNexus</Authors>
    <RepositoryUrl>https://github.com/onenexus-team/onenexus-sdks</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Typed .NET client for the OneNexus.Sdk.Cas.Support API.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OneNexus.Sdk.Core/OneNexus.Sdk.Core.csproj" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
