<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(PackageUnderTest)' == ''">
    <ProjectReference Include="../../src/OneNexus.Sdk.Cas.Support/OneNexus.Sdk.Cas.Support.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackageUnderTest)' != ''">
    <PackageReference Include="OneNexus.Sdk.Cas.Support" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <None Include="../../../specs/cas-support/openapi.json" Link="contracts/cas-support.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
