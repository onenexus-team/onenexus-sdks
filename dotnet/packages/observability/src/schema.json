    "common": {
      "additionalProperties": true,
      "properties": {
        "timestamp": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Timestamp",
          "type": "integer"
        },
        "level": {
          "enum": [
            "TRACE",
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR",
            "FATAL"
          ],
          "title": "Level",
          "type": "string"
        },
        "service": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Service",
          "type": "string"
        },
        "region": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Region",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "trace_id": {
          "not": {
            "const": "00000000000000000000000000000000"
          },
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        },
        "event": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Event",
          "type": "string"
        },
        "outcome": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Outcome",
          "type": "string"
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "staging",
            "prod"
          ],
          "title": "Environment"
        }
      },
      "required": [
        "timestamp",
        "level",
        "service",
        "environment",
        "region",
        "message"
      ],
      "title": "CommonRecord",
      "type": "object"
    },
