{
    "name": "@onenexus-team/cas-client",
    "version": "0.0.5",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/onenexus-team/onenexus-sdks.git",
        "directory": "ts/packages/cas-client"
    },
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            }
        }
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run --passWithNoTests",
        "generate": "../../../.tools/kiota/kiota generate --language TypeScript --openapi ../../../specs/cas/openapi.json --output ./src/generated --class-name CasApiClient --namespace-name OneNexus.Cas --clean-output --exclude-backward-compatible --additional-data false --structured-mime-types application/json --structured-mime-types application/problem+json"
    },
    "dependencies": {
        "@microsoft/kiota-abstractions": "1.0.0-preview.103",
        "@microsoft/kiota-serialization-form": "1.0.0-preview.103",
        "@microsoft/kiota-serialization-json": "1.0.0-preview.103",
        "@microsoft/kiota-serialization-multipart": "1.0.0-preview.103",
        "@microsoft/kiota-serialization-text": "1.0.0-preview.103",
        "@onenexus-team/sdk-core": "workspace:^"
    }
}
