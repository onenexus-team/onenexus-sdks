{
    "name": "@onenexus-team/observability",
    "version": "0.0.5",
    "type": "module",
    "description": "Opt-in Node.js structured logging and trace context",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/onenexus-team/onenexus-sdks.git",
        "directory": "ts/packages/observability"
    },
    "engines": {
        "node": ">24.17.0"
    },
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "types": "./dist/index.d.cts",
            "import": "./dist/index.cjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "exports": {
            ".": {
                "import": {
                    "types": "./dist/index.d.cts",
                    "default": "./dist/index.cjs"
                },
                "require": {
                    "types": "./dist/index.d.cts",
                    "default": "./dist/index.cjs"
                }
            }
        }
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@onenexus-team/log-contract": "workspace:*",
        "@opentelemetry/api": "1.10.0"
    },
    "devDependencies": {
        "@opentelemetry/context-async-hooks": "3.0.0",
        "@opentelemetry/sdk-trace": "3.0.0"
    }
}
