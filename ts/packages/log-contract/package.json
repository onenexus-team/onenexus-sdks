{
    "name": "@onenexus-team/log-contract",
    "version": "0.3.3",
    "type": "module",
    "description": "Generated OneNexus log contract and runtime validation",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/onenexus-team/onenexus-sdks.git",
        "directory": "ts/packages/log-contract"
    },
    "engines": {
        "node": ">24.17.0"
    },
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "types": "./dist/index.d.cts",
            "import": "./dist/index.cjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "exports": {
            ".": {
                "import": {
                    "types": "./dist/index.d.cts",
                    "default": "./dist/index.cjs"
                },
                "require": {
                    "types": "./dist/index.d.cts",
                    "default": "./dist/index.cjs"
                }
            }
        }
    },
    "scripts": {
        "generate": "node ../../../scripts/generate-ts-log-contract.mjs",
        "build": "pnpm generate && tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "ajv": "8.20.0"
    }
}
