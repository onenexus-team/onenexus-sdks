{
    "name": "@onenexus-team/sdk-ts-workspace",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.7.0",
    "engines": {
        "node": ">24.17.0",
        "pnpm": ">=11.7.0"
    },
    "scripts": {
        "sync-version": "node ../scripts/sync-ts-package-versions.mjs",
        "package": "pnpm run sync-version && pnpm -r --filter './packages/*-client' run generate && pnpm -r run build && pnpm -r run test && pnpm -r --filter './packages/*' exec pnpm pack --pack-destination ../../.local-packages"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1068.0",
        "@smithy/node-http-handler": "4.7.8",
        "@types/node": "22.10.2",
        "@vitest/coverage-v8": "2.1.8",
        "eslint": "9.17.0",
        "eslint-config-prettier": "9.1.0",
        "jose": "6.2.3",
        "msw": "2.7.0",
        "orval": "8.10.0",
        "prettier": "3.4.2",
        "tsup": "8.3.5",
        "tsx": "4.22.4",
        "typescript": "5.7.2",
        "typescript-eslint": "8.18.2",
        "vitest": "2.1.8"
    }
}
