  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "required": [
          "userId",
          "token",
          "password",
          "clientToken"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "clientToken": {
            "maxLength": 128,
            "minLength": 16,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "type": "string"
          }
        }
      },
      "AcceptInvitationResponse": {
        "required": [
          "userId",
          "tenantId",
          "email",
          "loginUrl"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "loginUrl": {
            "type": "string"
          }
        }
      },
      "AddServiceClientKeyRequest": {
        "required": [
          "serviceClientId",
          "publicJwk"
        ],
        "type": "object",
        "properties": {
          "serviceClientId": {
            "type": "string",
            "format": "uuid"
          },
          "publicJwk": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "AddServiceClientKeyResponse": {
        "required": [
          "serviceClient"
        ],
        "type": "object",
        "properties": {
          "serviceClient": {
            "$ref": "#/components/schemas/ServiceClientDto"
          }
        }
      },
      "AssumeS3RoleRequest": {
        "required": [
          "roleName"
        ],
        "type": "object",
        "properties": {
          "roleName": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "AssumeS3RoleResponse": {
        "required": [
          "accessKeyId",
          "secretAccessKey",
          "sessionToken",
          "expiration"
        ],
        "type": "object",
        "properties": {
          "accessKeyId": {
            "type": "string"
          },
          "secretAccessKey": {
            "type": "string"
          },
          "sessionToken": {
            "type": "string"
          },
          "expiration": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthorizationPolicyDto": {
        "required": [
          "id",
          "policyId",
          "name",
          "status",
          "document",
          "roleIds",
          "stateToken",
          "documentHash",
          "createdBy",
          "updatedBy"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "policyId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AuthorizationPolicyLifecycleStatus"
          },
          "document": {
            "$ref": "#/components/schemas/JsonElement"
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stateToken": {
            "type": "string"
          },
          "documentHash": {
            "type": "string"
          },
          "createdBy": {
            "type": "string"
          },
          "updatedBy": {
            "type": "string"
          },
          "publishedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "AuthorizationPolicyLifecycleStatus": {
        "type": "integer"
      },
      "AuthorizationPolicyPublicationDisposition": {
        "type": "integer"
      },
      "AuthorizationPolicySummary": {
        "required": [
          "id",
          "policyId",
          "name",
          "status",
          "documentHash",
          "stateToken"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "policyId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AuthorizationPolicyLifecycleStatus"
          },
          "documentHash": {
            "type": "string"
          },
          "stateToken": {
            "type": "string"
          },
          "publishedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "CreateServiceClientRequest": {
        "required": [
          "displayName",
          "publicJwk"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "publicJwk": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "CreateServiceClientResponse": {
