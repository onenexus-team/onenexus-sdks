{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:onenexus:log-correlation:0.3.2",
  "$defs": {
    "common": {
      "additionalProperties": true,
      "properties": {
        "timestamp": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Timestamp",
          "type": "integer"
        },
        "level": {
          "enum": [
            "TRACE",
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR",
            "FATAL"
          ],
          "title": "Level",
          "type": "string"
        },
        "service": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Service",
          "type": "string"
        },
        "region": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Region",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "trace_id": {
          "not": {
            "const": "00000000000000000000000000000000"
          },
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        },
        "event": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Event",
          "type": "string"
        },
        "outcome": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Outcome",
          "type": "string"
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "staging",
            "prod"
          ],
          "title": "Environment"
        }
      },
      "required": [
        "timestamp",
        "level",
        "service",
        "environment",
        "region",
        "message"
      ],
      "title": "CommonRecord",
      "type": "object"
    },
    "correlated": {
      "additionalProperties": true,
      "properties": {
        "timestamp": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Timestamp",
          "type": "integer"
        },
        "level": {
          "enum": [
            "TRACE",
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR",
            "FATAL"
          ],
          "title": "Level",
          "type": "string"
        },
        "service": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Service",
          "type": "string"
        },
        "region": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Region",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "trace_id": {
          "not": {
            "const": "00000000000000000000000000000000"
          },
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        },
        "event": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Event",
          "type": "string"
        },
        "outcome": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Outcome",
          "type": "string"
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "staging",
            "prod"
          ],
          "title": "Environment"
        }
      },
      "required": [
        "timestamp",
        "level",
        "service",
        "environment",
        "region",
        "message",
        "trace_id"
      ],
      "title": "CorrelatedRecord",
      "type": "object"
    },
    "lifecycle": {
      "additionalProperties": true,
      "properties": {
        "timestamp": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Timestamp",
          "type": "integer"
        },
        "level": {
          "enum": [
            "TRACE",
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR",
            "FATAL"
          ],
          "title": "Level",
          "type": "string"
        },
        "service": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Service",
          "type": "string"
        },
        "region": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Region",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "trace_id": {
          "not": {
            "const": "00000000000000000000000000000000"
          },
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        },
        "event": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Event",
          "type": "string"
        },
        "outcome": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Outcome",
          "type": "string"
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "staging",
            "prod"
          ],
          "title": "Environment"
        }
      },
      "required": [
        "timestamp",
        "level",
        "service",
        "environment",
        "region",
        "message",
        "trace_id",
        "event",
        "outcome"
      ],
      "title": "LifecycleRecord",
      "type": "object"
    },
    "request": {
      "additionalProperties": true,
      "properties": {
        "timestamp": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Timestamp",
          "type": "integer"
        },
        "level": {
          "enum": [
            "TRACE",
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR",
            "FATAL"
          ],
          "title": "Level",
          "type": "string"
        },
        "service": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Service",
          "type": "string"
        },
        "region": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Region",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "trace_id": {
          "not": {
            "const": "00000000000000000000000000000000"
          },
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        },
        "event": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Event",
          "type": "string"
        },
        "outcome": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Outcome",
          "type": "string"
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "staging",
            "prod"
          ],
          "title": "Environment"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "not": {
            "pattern": "[\\r\\n]",
            "type": "string"
          }
        },
        "principal_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^nx1://[A-Za-z0-9._:-]+/[0-9a-f]{32}/[A-Za-z0-9._:-]+/[A-Za-z0-9._:-]+/(User|ServiceClient|Workload)/[A-Za-z0-9._:-]+$",
          "not": {
            "pattern": "[\\r\\n]",
            "type": "string"
          }
        },
        "tenant_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "not": {
            "const": "00000000000000000000000000000000"
          }
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "not": {
            "pattern": "[\\r\\n]",
            "type": "string"
          }
        },
        "request_event": {
          "enum": [
            "completed",
            "interrupted"
          ]
        },
        "http.request.method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Z]+$",
          "not": {
            "pattern": "[\\r\\n]",
            "type": "string"
          }
        },
        "http.route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[ -~]+$",
          "not": {
            "pattern": "[\\r\\n]",
            "type": "string"
          }
        },
        "http.response.status_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "timestamp",
        "level",
        "service",
        "environment",
        "region",
        "message",
        "request_id",
        "principal_id",
        "tenant_id",
        "error_code",
        "request_event",
        "http.request.method",
        "http.route",
        "http.response.status_code",
        "duration_ms"
      ],
      "title": "RequestRecord",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "request_event": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "http.response.status_code": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "http.response.status_code": {
                "type": "integer",
                "minimum": 400
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "principal_id": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "tenant_id": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/common",
  "x-contract-version": "0.3.2",
  "x-semantic-checks": {
    "message_max_utf8_bytes": 1024,
    "record_max_compact_utf8_bytes": 4096,
    "serialization": "UTF-8 JSON, ensure_ascii=false, compact separators; reject non-finite numbers",
    "profile_selection": "Chosen by the test scenario, never by the producer"
  }
}
